#!/bin/sh
# gh auth git-credential は host のアクティブアカウントのトークンしか返さないので、
# 同じ host の複数アカウントを使い分けられない。リポジトリの user.email に
# 一致するメールアドレスを持つ gh アカウントのトークンを返す
#
# アカウントとメールアドレスの対応は API を叩くので 1 日キャッシュする。
# gh のアカウントやメールアドレスを変えたら ~/.cache/git-credential-gh を消す
[ "$1" = get ] || exit 0

while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    case "$key" in
        host) host=$value ;;
        username) username=$value ;;
    esac
done
[ -n "$host" ] || exit 0

emit() {
    token=$(gh auth token --hostname "$host" --user "$1" 2>/dev/null) || exit 0
    printf 'username=%s\npassword=%s\n' "$1" "$token"
    exit 0
}

# URL などで明示されたアカウントを優先する
[ -n "$username" ] && emit "$username"

cache_dir=${XDG_CACHE_HOME:-$HOME/.cache}/git-credential-gh
cache=$cache_dir/$host
if [ -z "$(find "$cache" -mmin -1440 2>/dev/null)" ]; then
    mkdir -p "$cache_dir"
    tmp=$cache.$$
    gh auth status --hostname "$host" --json hosts \
        --jq ".hosts[\"$host\"][] | [.login, .active] | @tsv" 2>/dev/null |
    while IFS="$(printf '\t')" read -r login active; do
        [ "$active" = true ] && printf '%s\t*active*\n' "$login"
        token=$(gh auth token --hostname "$host" --user "$login" 2>/dev/null) || continue
        # user:email スコープがあれば登録済みの全アドレス、なければ公開アドレスだけ
        # (失敗時は gh がエラーの JSON を stdout に出すので、成功時だけ使う)
        emails=$(GH_TOKEN=$token gh api --hostname "$host" user/emails --jq '.[].email' 2>/dev/null) ||
        emails=$(GH_TOKEN=$token gh api --hostname "$host" user --jq '.email // empty' 2>/dev/null) ||
        emails=
        for email in $emails; do
            printf '%s\t%s\n' "$login" "$email"
        done
    done > "$tmp" && mv "$tmp" "$cache"
fi

email=$(git config user.email | tr '[:upper:]' '[:lower:]')
login=$(awk -F '\t' -v e="$email" 'e != "" && tolower($2) == e { print $1; exit }' "$cache" 2>/dev/null)
[ -n "$login" ] || login=$(awk -F '\t' '$2 == "*active*" { print $1; exit }' "$cache" 2>/dev/null)
[ -n "$login" ] && emit "$login"
