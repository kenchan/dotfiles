#!/bin/sh
# gh auth git-credential は username を無視して host のアクティブアカウントの
# トークンを返すので、username が指定されたときだけ gh auth token --user を使う
[ "$1" = get ] || exit 0

input=$(cat)
host=$(printf '%s\n' "$input" | sed -n 's/^host=//p')
user=$(printf '%s\n' "$input" | sed -n 's/^username=//p')

if [ -n "$user" ]; then
    token=$(gh auth token --hostname "$host" --user "$user") || exit 0
    printf 'username=%s\npassword=%s\n' "$user" "$token"
else
    printf '%s\n\n' "$input" | gh auth git-credential get
fi
