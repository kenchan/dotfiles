#!/bin/sh
# gh auth git-credential は host のアクティブアカウントのトークンしか返さず、
# credential.username で指定した別アカウント（github.com の個人用と
# 業務用など）を使い分けられないので、username に応じて
# gh auth token --user を呼ぶ
[ "$1" = get ] || exit 0

while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    case "$key" in
        host) host=$value ;;
        username) username=$value ;;
    esac
done

[ -n "$host" ] || exit 0
if [ -n "$username" ]; then
    token=$(gh auth token --hostname "$host" --user "$username" 2>/dev/null) || exit 0
else
    username=$(gh api --hostname "$host" user --jq .login 2>/dev/null) || exit 0
    token=$(gh auth token --hostname "$host" 2>/dev/null) || exit 0
fi

printf 'username=%s\npassword=%s\n' "$username" "$token"
