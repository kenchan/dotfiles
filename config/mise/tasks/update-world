#!/usr/bin/env bash
#MISE description="Update mise tools and system packages"
set -euo pipefail

# ディストリのパッケージとして入れた mise は self-update 無効でビルドされているので、パッケージマネージャ側の更新に任せる
if [[ "$(mise doctor --json 2>/dev/null | jq '.self_update_available')" == "true" ]]; then
    mise self-update -y
fi

if command -v gh &> /dev/null; then
    export GITHUB_TOKEN="$(gh auth token)"
    # mise は GitHub Enterprise の api_url を持つツールにも GITHUB_TOKEN を送り、401 で失敗する。
    # gh がログインしている github.com 以外のホストが 1 つだけなら、そのトークンを渡す
    ghe_hosts=$(gh auth status 2>/dev/null | grep -E '^[^ ]' | grep -vx 'github.com' || true)
    if [[ -n "$ghe_hosts" && "$(wc -l <<<"$ghe_hosts")" -eq 1 ]]; then
        export MISE_GITHUB_ENTERPRISE_TOKEN="$(gh auth token --hostname "$ghe_hosts")"
    fi
fi

mise up
mise prune -y
mise cache prune

if command -v gh &> /dev/null; then
    gh extension upgrade --all
fi

if command -v fish &> /dev/null; then
    fish -c "type -q fisher; and fisher update"
fi

if command -v herdr &> /dev/null; then
    # 設定ディレクトリが無いと install が失敗する
    if [[ -d "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ]]; then
        herdr integration install claude
    fi
    if [[ -d "${CODEX_HOME:-$HOME/.codex}" ]]; then
        herdr integration install codex
    fi
fi

if command -v apm &> /dev/null; then
    apm install -g
    apm update -g --yes
fi

if command -v emerge &> /dev/null; then
    sudo eix-sync -a
    sudo emerge -uDN @world -j2
    sudo emerge --depclean
    if command -v eclean &> /dev/null; then
        sudo eclean-dist --deep
        sudo eclean-pkg --deep
    fi
elif command -v pacman &> /dev/null; then
    if command -v paru &> /dev/null; then
        paru -Syu --noconfirm --skipreview
        paru -c --noconfirm
        sudo find /var/cache/pacman/pkg -mindepth 1 -maxdepth 1 -type d -name 'download-*' -empty -delete
        paru -Sc --noconfirm
    else
        sudo pacman -Syu --noconfirm
        if orphans=$(pacman -Qdtq); then
            sudo pacman -Rns $orphans --noconfirm
        fi
        sudo find /var/cache/pacman/pkg -mindepth 1 -maxdepth 1 -type d -name 'download-*' -empty -delete
        sudo pacman -Sc --noconfirm
    fi
fi
