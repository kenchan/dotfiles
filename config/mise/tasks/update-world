#!/usr/bin/env bash
#MISE description="Update mise tools and system packages"
set -euo pipefail

# トークンはこのスクリプトでは取らず、呼ぶ側が環境変数で渡す。例:
#   GITHUB_TOKEN=$(gh auth token) mise run update-world
# GITHUB_TOKEN は mise と Nix(GitHub API の回数制限よけ)が使う。mise は GitHub Enterprise の
# api_url を持つツールにも GITHUB_TOKEN を送って 401 になるので、そういうツールがあるマシンでは
# MISE_GITHUB_ENTERPRISE_TOKEN も渡す

if command -v darwin-rebuild &> /dev/null; then
    # macOS: Touch ID(sudo)を聞かれる処理を先に済ませて、あとは放っておけるようにする。
    # nix-darwin の設定(github.com/kenchan/nix-config)の入力を上げて反映し、switch では上げない
    # 設定にしている Homebrew の cask もここで上げる(cask によっては sudo を聞かれる)
    nix_config="$HOME/src/github.com/kenchan/nix-config"
    # 共有の IP だと GitHub API の未認証の回数制限にすぐ当たるので、GITHUB_TOKEN があれば Nix にも渡す
    nix_opts=()
    if [[ -n "${GITHUB_TOKEN:-}" ]]; then
        nix_opts=(--option access-tokens "github.com=$GITHUB_TOKEN")
    fi
    nix flake update --flake "$nix_config" "${nix_opts[@]}"
    sudo darwin-rebuild switch --flake "$nix_config#default"
    brew update
    brew upgrade --yes   # Homebrew 7 からは確認を求めて止まるので
fi

# ディストリのパッケージとして入れた mise は self-update 無効でビルドされているので、パッケージマネージャ側の更新に任せる
if [[ "$(mise doctor --json 2>/dev/null | jq '.self_update_available')" == "true" ]]; then
    mise self-update -y
fi

mise up
mise prune -y
mise cache prune

if command -v gh &> /dev/null; then
    gh extension upgrade --all
fi

if command -v fish &> /dev/null; then
    fish -c "type -q fisher; and fisher update"
fi

if command -v herdr &> /dev/null; then
    # 設定ディレクトリが無いと install が失敗する
    if [[ -d "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" ]]; then
        herdr integration install claude
    fi
    if [[ -d "${CODEX_HOME:-$HOME/.codex}" ]]; then
        herdr integration install codex
    fi
fi

if command -v apm &> /dev/null; then
    apm install -g
    apm update -g --yes
fi

if command -v emerge &> /dev/null; then
    sudo eix-sync -a
    sudo emerge -uDN @world -j2
    sudo emerge --depclean
    if command -v eclean &> /dev/null; then
        sudo eclean-dist --deep
        sudo eclean-pkg --deep
    fi
elif command -v pacman &> /dev/null; then
    if command -v paru &> /dev/null; then
        paru -Syu --noconfirm --skipreview
        paru -c --noconfirm
        sudo find /var/cache/pacman/pkg -mindepth 1 -maxdepth 1 -type d -name 'download-*' -empty -delete
        paru -Sc --noconfirm
    else
        sudo pacman -Syu --noconfirm
        if orphans=$(pacman -Qdtq); then
            sudo pacman -Rns $orphans --noconfirm
        fi
        sudo find /var/cache/pacman/pkg -mindepth 1 -maxdepth 1 -type d -name 'download-*' -empty -delete
        sudo pacman -Sc --noconfirm
    fi
elif command -v darwin-rebuild &> /dev/null; then
    # Nix と Homebrew は先頭で上げ済み。
    # Docker 用の Lima の VM(Ubuntu)。VM の中の sudo はパスワードなしで通る。セキュリティ更新は VM の中の
    # unattended-upgrades が入れるが、Docker 社のリポジトリから入れた Docker 本体は対象外なので、ここでまとめて上げる。
    # upgrade だと新しいカーネルのように別パッケージとして入る更新が保留のまま残るので full-upgrade にする。
    # カーネルなどが上がって再起動が必要になったら、VM を再起動する(動いているコンテナは止まる)
    if command -v limactl &> /dev/null && [[ "$(limactl list --format '{{.Status}}' docker 2>/dev/null)" == "Running" ]]; then
        limactl shell docker sudo sh -c 'apt-get update && DEBIAN_FRONTEND=noninteractive apt-get -y full-upgrade && apt-get -y autoremove'
        if limactl shell docker test -e /var/run/reboot-required; then
            echo "Lima の VM を再起動します"
            limactl stop docker
            limactl start --tty=false docker
        fi
    fi

    git -C "$nix_config" status --short flake.lock
fi
