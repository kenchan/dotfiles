{
  "env": {
    "GIT_COMMITTER_NAME": "Claude Code",
    "GIT_COMMITTER_EMAIL": "claude-code@anthropic.localhost",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "commit.gpgsign",
    "GIT_CONFIG_VALUE_0": "false"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"UserPromptSubmit\",\"additionalContext\":\"Current time: '$(date +%H:%M:%S%z)'\"}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -j '.tool_input.file_path' | xargs -0 perl -pi -e '$_ .= \"\\n\" if eof && !/\\n\\z/'"
          },
          {
            "type": "command",
            "command": "jq -j '.tool_input.file_path' | xargs -0 perl -pi -e 's/[^\\S\\n]+$//'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.bash"
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "advisorModel": "fable",
  "tui": "fullscreen",
  "theme": "auto",
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "Using the gh CLI (any host, any subcommand: issue/pr create, comment, edit, close, gh api reads and writes) is allowed"
    ]
  },
  "model": "opus"
}
